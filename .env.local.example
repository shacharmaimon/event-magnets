# Copy this file to ".env.local" and fill in the real values from your
# Supabase project (Settings -> API Keys). .env.local is git-ignored, so your
# real keys never get committed.

# Your project URL (safe, public).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# The "anon" / "public" key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The "service_role" key (SECRET — server only, never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The public site URL, used to build guest links + QR codes (e.g. the Vercel URL
# in production). Falls back to the browser origin if unset.
NEXT_PUBLIC_SITE_URL=https://event-magnets-drab.vercel.app
