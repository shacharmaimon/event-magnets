# Secrets & environment — NEVER commit these
.env
.env.*
*.local
secrets/
*.pem
*.key

# Dependencies (auto-generated, re-installable)
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build output
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Uploaded/generated media during local testing
uploads/
tmp/
